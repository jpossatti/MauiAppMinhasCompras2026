<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras2026.Views.ListaProduto"
             Title="Minhas Compras"
             BackgroundColor="#1A1A1A">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Somar_Clicked" />
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Adicionar_Clicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="5" 
                             Padding="20" 
                             BackgroundColor="#1A1A1A">

            <!-- Linha Decorativa Topo -->
            <BoxView HeightRequest="5" 
                     Color="#3498DB" 
                     Margin="0,0,0,15" />

            <!-- Campo de Busca -->
            <SearchBar x:Name="txt_search"
                       Placeholder="Busca de Produtos"
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF"
                       BackgroundColor="#2C2C2C"
                       Margin="0,0,0,15"
                       TextChanged="txt_search_TextChanged" />

            <Label Text="LISTA DE PRODUTOS" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#FFFFFF" 
                   Margin="0,0,0,15"
                   HorizontalOptions="Center" />

            <!-- Container da Tabela -->
            <Frame BackgroundColor="#2C2C2C" 
                   CornerRadius="15" 
                   Padding="0" 
                   Margin="0,10,0,20"
                   BorderColor="#3D3D3D"
                   HasShadow="True">

                <VerticalStackLayout Spacing="0">

                    <!-- Cabeçalho da Tabela -->
                    <Grid BackgroundColor="#3498DB" 
                          Padding="15"
                          ColumnDefinitions="*, *, *, *">
                        <Label Grid.Column="0" 
                               Text="Produto" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#FFFFFF" 
                               Margin="0"
                               HorizontalOptions="Center" />
                        <Label Grid.Column="1" 
                               Text="Qnt" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#FFFFFF" 
                               Margin="0"
                               HorizontalOptions="Center" />
                        <Label Grid.Column="2" 
                               Text="Preço" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#FFFFFF" 
                               Margin="0"
                               HorizontalOptions="Center" />
                        <Label Grid.Column="3" 
                               Text="Total" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#FFFFFF" 
                               Margin="0"
                               HorizontalOptions="Center" />
                    </Grid>

                    <!-- Lista de Produtos -->
                    <CollectionView x:Name="ProdutosCollectionView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSelectionChanged"
                                    HeightRequest="350"
                                    BackgroundColor="#2C2C2C">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10" 
                                      Margin="0,1,0,1"
                                      BackgroundColor="#222222"
                                      ColumnDefinitions="*, *, *, *">

                                    <Label Grid.Column="0" 
                                           Text="{Binding Descricao}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#FFFFFF"
                                           Margin="0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                    <Label Grid.Column="1" 
                                           Text="{Binding Quantidade}"
                                           FontSize="14"
                                           TextColor="#E0E0E0"
                                           Margin="0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                    <Label Grid.Column="2" 
                                           Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                           FontSize="14"
                                           TextColor="#E0E0E0"
                                           Margin="0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                    <Label Grid.Column="3" 
                                           Text="{Binding Total, StringFormat='R$ {0:F2}'}"
                                           FontSize="14"
                                           TextColor="#2ECC71"
                                           FontAttributes="Bold"
                                           Margin="0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Frame>

            <!-- Total Geral -->
            <Frame BackgroundColor="#27AE60" 
                   CornerRadius="15" 
                   Padding="15" 
                   Margin="0,0,0,20"
                   BorderColor="#27AE60"
                   HasShadow="True">
                <Grid ColumnDefinitions="*, *">
                    <Label Text="TOTAL DA COMPRA:" 
                           FontAttributes="Bold" 
                           FontSize="16" 
                           TextColor="#FFFFFF"
                           Margin="0"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" 
                           x:Name="lblTotalGeral"
                           Text="R$ 0,00"
                           FontAttributes="Bold" 
                           FontSize="18" 
                           TextColor="#FFFFFF"
                           Margin="0"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Card Dica -->
            <Frame BackgroundColor="#2C2C2C" 
                   CornerRadius="10" 
                   Padding="15"
                   BorderColor="#3498DB"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="💡 Dica" 
                           FontAttributes="Bold" 
                           TextColor="#3498DB"
                           Margin="0"
                           FontSize="14" />
                    <Label Text="Clique em um produto para editá-lo ou excluí-lo." 
                           TextColor="#CCCCCC"
                           Margin="0"
                           FontSize="13" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>