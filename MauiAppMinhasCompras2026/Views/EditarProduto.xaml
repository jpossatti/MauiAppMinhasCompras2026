<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras2026.Views.EditarProduto"
             Title="Editar Produto">

    <Grid Padding="20" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Label Text="Editar Produto" 
               FontSize="24" 
               FontAttributes="Bold"
               Grid.Row="0"/>

        <!-- Campo Descrição -->
        <Label Text="Descrição:" 
               FontSize="16" 
               Grid.Row="1"/>
        <Entry x:Name="txtDescricao" 
               Placeholder="Digite a descrição do produto"
               Grid.Row="2"/>

        <!-- Campo Quantidade -->
        <Label Text="Quantidade:" 
               FontSize="16" 
               Grid.Row="3"/>
        <Entry x:Name="txtQuantidade" 
               Placeholder="Digite a quantidade"
               Keyboard="Numeric"
               Grid.Row="4"/>

        <!-- Campo Preço -->
        <Label Text="Preço:" 
               FontSize="16" 
               Grid.Row="5"/>
        <Entry x:Name="txtPreco" 
               Placeholder="Digite o preço"
               Keyboard="Numeric"
               Grid.Row="6"/>

        <!-- Botões -->
        <Grid Grid.Row="7" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Text="Excluir" 
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Grid.Column="0"
                    Clicked="OnExcluirClicked"/>

            <Button Text="Salvar" 
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Grid.Column="1"
                    Clicked="OnSalvarClicked"/>
        </Grid>
    </Grid>
</ContentPage>